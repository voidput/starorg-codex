{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarOrg Codex",
  "mainBinaryName": "starorg-strings-app",
  "identifier": "tools.starorg.strings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "StarOrg Codex",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self'",
        "media-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Star Citizen text enhancements",
    "copyright": "Copyright (c) 2026 StarOrg Tools. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/voidput/starorg-strings",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/starorg-strings-app.desktop": "linux/starorg-strings-app.desktop"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/applications/starorg-strings-app.desktop": "linux/starorg-strings-app.desktop"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE-WITH-THE-PUBLIC-KEY-FROM-npx-tauri-signer-generate",
      "endpoints": []
    }
  }
}
